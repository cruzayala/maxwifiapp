# ═══════════════════════════════════════════════════════════════
# ISP Max - Variables de entorno
# Copia a .env y completa con tus valores reales
# NO commitear .env al repositorio
# ═══════════════════════════════════════════════════════════════

# ─── DATABASE ───
# SQLite local. En Railway usa file:/data/data.db sobre un volumen persistente.
DATABASE_URL="file:./data.db"

# ─── WISPHUB ───
WISPHUB_API_KEY=""

# ─── SERVER ───
# Railway asigna PORT automaticamente; en local usa 7400 o 7402
PORT=7400
NODE_ENV="production"
# Origenes web adicionales permitidos, separados por coma.
# Railway agrega automaticamente su dominio publico.
CORS_ALLOWED_ORIGINS=""
# URL publica completa del entorno. Railway puede derivarla automaticamente,
# pero definirla hace el despliegue portable a cualquier proveedor.
PUBLIC_APP_URL="http://localhost:7400"

# ─── AUTENTICACION ───
# El sistema usa usuarios con clave (tabla User en BD).
# En produccion son obligatorias si la tabla User esta vacia.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="cambia-esta-clave-larga"
ADMIN_FULL_NAME="Super Administrador"

# ─── MIKROTIK ───
# Desde Railway: usa la IP publica del MikroTik (154.88.128.162-165)
# Desde LAN:     192.168.10.1 / 192.168.13.1
MIKROTIK_HOST=""
MIKROTIK_USER=""
MIKROTIK_PASS=""
MIKROTIK_PORT="8728"
MIKROTIK_ENABLED="true" # false en local para no conectar al router
MIKROTIK_WAN_IFACE="sfp2"
MIKROTIK_WAN_MAX_MBPS="1000"
# Redes donde viven las IP de clientes. Se usan para detectar equipos desconocidos.
MIKROTIK_CLIENT_NETWORKS="192.168.10.0/23,192.168.12.0/22,192.168.16.0/24"
# Tiempo maximo por comando y lecturas en cola antes de rechazar nuevas (las escrituras tienen prioridad).
MIKROTIK_TIMEOUT_MS="6000"
MIKROTIK_MAX_PENDING_READS="40"
# Version minima aceptada por la auditoria interna; no actualiza el router automaticamente.
MIKROTIK_MIN_VERSION="7.20.8"

# Centro NOC: solo observa y registra caidas colectivas; no modifica el router.
NOC_ENABLED="true"
NOC_INTERVAL_MS="60000"
NOC_MIN_AFFECTED="3"
NOC_MIN_RATIO="0.30"

# Auditoria historica de trafico/estabilidad. No ejecuta speedtests masivos.
NETWORK_AUDIT_ENABLED="true"
NETWORK_AUDIT_INTERVAL_MS="600000"
NETWORK_AUDIT_RAW_DAYS="14"
NETWORK_AUDIT_WAN_DAYS="365"

# --- OLT ZTE C320 ---
# Use la IP privada cuando el servidor comparte la red/VPN con la OLT.
# Las credenciales nunca se exponen al navegador.
OLT_ENABLED="false"
OLT_AUTO_AUTHORIZE_AGENT="false"
OLT_HOST=""
OLT_PORT="23"
OLT_USER=""
OLT_PASS=""
# Estado/ alarmas cada minuto; modelos y seriales cada 10 minutos.
OLT_SYNC_INTERVAL_MS="60000"
OLT_INVENTORY_INTERVAL_MS="600000"
OLT_CONNECT_TIMEOUT_MS="8000"
OLT_COMMAND_TIMEOUT_MS="15000"
# Umbrales de senal optica (dBm) y capacidad por puerto PON.
OLT_WEAK_RX_DBM="-27"
OLT_CRITICAL_RX_DBM="-30"
OLT_POWER_DROP_DB="3"
OLT_PON_CAPACITY="128"

# --- AGENTES ONU STUDIO Y TR-069 ---
# Clave para cifrar los datos sensibles de las tareas TR-069 (por ejemplo la clave WiFi).
# Obligatoria para cambiar el WiFi por TR-069. Genera una larga y aleatoria.
TR069_TASK_ENCRYPTION_KEY=""
TR069_TASK_LEASE_MS="120000"
ONU_AGENT_TASK_LEASE_MS="180000"
ONU_AGENT_ONLINE_MS="30000"

# ─── CAPTIVE PORTAL ───
# Cuando se bloquea un cliente, el MikroTik redirige TCP/80 a este host:port
# CAPTIVE_AUTOCONFIG=true: al boot el server detecta su IP publica via ipify
#   y reescribe las reglas NAT del MikroTik. Ideal para Railway (IP cambia).
# Si lo dejas en false, debes ejecutar setup manual con tu IP publica.
CAPTIVE_AUTOCONFIG="true"
CAPTIVE_PORT="7400"
# Host fijo para el portal (si no, se usa PUBLIC_APP_URL). Con CAPTIVE_HOST se usa CAPTIVE_PORT.
CAPTIVE_HOST=""
# Hosts propios de la app separados por coma; cualquier otro Host se trata como cliente redirigido.
CRM_KNOWN_HOSTS=""

# ─── ALLOWED IPS para MikroTik (lo usa scripts/setup-mikrotik-access.js) ───
# Direcciones de salida verificadas del proveedor actual; no copies rangos de otro entorno.
ALLOWED_IPS=""

# ─── SYNC LOOP ───
# Cada cuanto sincronizar Wisphub + MikroTik a la BD local (ms)
SYNC_INTERVAL_MS="60000"
WISPHUB_SYNC_ENABLED="true" # false en local para no consultar WispHub/MikroTik
# Desde que fecha importar el historial de facturas (AAAA-MM-DD).
WISPHUB_INVOICE_SYNC_START_DATE=""
# Recalculo de metricas de clientes (ms).
METRICS_INTERVAL_MS="120000"

# ─── FACTURAS, RECIBOS Y PORTAL DE PAGO ───
# Nombre del negocio que aparece en la factura
INVOICE_BUSINESS_NAME="MaxWifi"
# Telefono de soporte que aparece en la factura
SUPPORT_PHONE=""
# Telefono alterno si SUPPORT_PHONE esta vacio.
INVOICE_SUPPORT_PHONE=""
# Bancos / metodos de pago - separar con | (pipe)
INVOICE_BANK_INFO="Banco BHD: 1234567890 - MaxWifi SRL|BanReservas: 9876543210|Transferencia: 829-XXX-XXXX"

# ─── WHATSAPP NOTIFICACIONES AUTOMATICAS ───
NOTIF_ENABLED="false"
NOTIF_RUN_HOUR="10"
# false para no abrir la sesion de WhatsApp al arrancar (por ejemplo en local).
WHATSAPP_AUTOSTART="true"

# Recordatorios automáticos de encuestas. Usa false en local para no enviar WhatsApp.
SURVEY_REMINDERS_ENABLED="false"
SURVEY_REMINDER_INTERVAL_HOURS="168"
SURVEY_REMINDER_MAX="3"
SURVEY_REMINDER_POLL_MS="1800000"

# ─── AUTO-BLOQUEO POR MORA ───
AUTO_BLOCK_ENABLED="false"
AUTO_BLOCK_MOROSO_DAYS="0"
AUTO_BLOCK_HARD_DAYS="7"
AUTO_BLOCK_RUN_HOUR="9"

# ─── MANTENIMIENTO DE LA BASE ───
# Cada N dias (a la hora indicada) poda el historial que solo se lee por lo mas
# reciente y compacta la base. Nunca toca clientes, facturas, pagos ni inventario.
DB_MAINTENANCE_INTERVAL_DAYS="15"
DB_MAINTENANCE_RUN_HOUR="3"
DB_MAINTENANCE_TZ="America/Santo_Domingo"
DB_KEEP_SYNC_LOG_DAYS="30"
DB_KEEP_OLT_SNAPSHOT_DAYS="30"
DB_KEEP_CLEARED_OLT_ALARM_DAYS="90"
DB_KEEP_TR069_TELEMETRY_DAYS="90"

# ─── WEB ACTIVITY TRACKING (DNS log) ───
WEB_ACTIVITY_ENABLED="true"
WEB_ACTIVITY_POLL_MS="60000"
WEB_ACTIVITY_KEEP_DAYS="30"
