<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>OnuStudio.Core</AssemblyName>
    <RootNamespace>OnuStudio.Core</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.31" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.11" />
    <PackageReference Include="Microsoft.Playwright" Version="1.62.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- Las pruebas comprueban reglas internas (seriales, nombres WAN, sanitizado). -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>OnuStudio.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
