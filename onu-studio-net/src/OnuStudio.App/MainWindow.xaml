<Window x:Class="OnuStudio.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:OnuStudio.App.Views"
        xmlns:vm="clr-namespace:OnuStudio.App.ViewModels"
        Title="ONU Studio | ISP Max"
        Height="720" Width="1180" MinHeight="600" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Canvas}"
        FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ── Barra lateral ── -->
        <Border Grid.Column="0" Background="{StaticResource RailBackground}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="24,26,24,20">
                    <TextBlock Text="ONU STUDIO" Foreground="White" FontSize="17" FontWeight="Bold"
                               FontFamily="{StaticResource DisplayFont}" />
                    <TextBlock Text="ISP Max" Foreground="#6E8CA6" FontSize="12.5" Margin="0,3,0,0" />
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,4,0,0">
                    <RadioButton Style="{StaticResource RailButton}" GroupName="nav"
                                 IsChecked="{Binding IsWizard, Mode=OneWay}"
                                 Command="{Binding GoToCommand}" CommandParameter="Wizard"
                                 Content="Configurar una ONU" />
                    <RadioButton Style="{StaticResource RailButton}" GroupName="nav"
                                 IsChecked="{Binding IsDevice, Mode=OneWay}"
                                 Command="{Binding GoToCommand}" CommandParameter="Device"
                                 Content="Equipo del cliente" />
                    <RadioButton Style="{StaticResource RailButton}" GroupName="nav"
                                 IsChecked="{Binding IsHistory, Mode=OneWay}"
                                 Command="{Binding GoToCommand}" CommandParameter="History"
                                 Content="Historial" />
                    <RadioButton Style="{StaticResource RailButton}" GroupName="nav"
                                 IsChecked="{Binding IsSettings, Mode=OneWay}"
                                 Command="{Binding GoToCommand}" CommandParameter="Settings"
                                 Content="Ajustes" />
                </StackPanel>

                <!-- Estado permanente: lo que el tecnico necesita ver de un vistazo -->
                <StackPanel Grid.Row="3" Margin="20,0,20,22">
                    <Border Background="#16304A" CornerRadius="10" Padding="14,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                         Fill="{Binding CloudTone, Converter={StaticResource Tone}}" />
                                <TextBlock Text="{Binding CloudState}" Foreground="White" FontSize="12.5"
                                           FontWeight="SemiBold" Margin="8,0,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBlock Text="{Binding AgentState}" Foreground="#7F9CB5" FontSize="11.5"
                                       Margin="16,5,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Background="#16304A" CornerRadius="10" Padding="14,12" Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                     Fill="{Binding DeviceTone, Converter={StaticResource Tone}}" />
                            <TextBlock Text="{Binding DeviceState}" Foreground="#C9DCEB" FontSize="12"
                                       Margin="8,0,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{Binding AdminState}" Foreground="#5E7D96" FontSize="11" Margin="4,10,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── Contenido ── -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                    BorderThickness="0,0,0,1" Padding="32,20">
                <StackPanel>
                    <TextBlock Text="{Binding PageTitle}" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="{Binding PageSubtitle}" Style="{StaticResource Body}" Margin="0,5,0,0" />
                </StackPanel>
            </Border>

            <Grid Grid.Row="1">
                <views:WizardView DataContext="{Binding Wizard}"
                                  Visibility="{Binding DataContext.IsWizard, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}" />
                <views:DeviceView DataContext="{Binding Device}"
                                  Visibility="{Binding DataContext.IsDevice, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}" />
                <views:HistoryView DataContext="{Binding History}"
                                   Visibility="{Binding DataContext.IsHistory, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}" />
                <views:SettingsView DataContext="{Binding Settings}"
                                    Visibility="{Binding DataContext.IsSettings, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}" />

                <!-- Aviso flotante -->
                <Border VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,28,24"
                        CornerRadius="10" Padding="16,12" MaxWidth="420"
                        Background="{Binding ToastTone, Converter={StaticResource ToneSoft}}"
                        BorderBrush="{Binding ToastTone, Converter={StaticResource Tone}}" BorderThickness="1"
                        Visibility="{Binding HasToast, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding Toast}" TextWrapping="Wrap" FontSize="13" FontWeight="SemiBold"
                               Foreground="{Binding ToastTone, Converter={StaticResource Tone}}" />
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
