<UserControl x:Class="OnuStudio.App.Views.Wizard.ClientStepView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:OnuStudio.App.Controls">

    <!-- Paso 2: que se hace, tipo de servicio, cliente, plan e IP. Cada decision abre la
         siguiente. El DataContext es el WizardViewModel. -->
    <StackPanel>

        <!-- Sin sesion con ISP Max no se puede seguir -->
        <controls:WizardSection Number="!" Title="Conecta ONU Studio con ISP Max"
                                Hint="Con tu usuario de ISP Max. Esta PC queda recordada de forma segura."
                                Visibility="{Binding CloudConnected, Converter={StaticResource InverseBoolToVisibility}}"
                                controls:Motion.Entrance="True" controls:Motion.OffsetY="0" controls:Motion.OffsetX="{Binding SlideFrom}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Direccion de ISP Max" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding CloudUrl, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Usuario" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding CloudUsername, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Contrasena" Style="{StaticResource FieldLabel}" />
                        <PasswordBox controls:PasswordBoxAssistant.BoundPassword="{Binding CloudPassword, Mode=TwoWay}" />
                    </StackPanel>
                </Grid>
                <Button Content="Conectar" Style="{StaticResource PrimaryButton}" MinWidth="140"
                        Command="{Binding LoginCommand}" HorizontalAlignment="Left" Margin="0,16,0,0" />
            </StackPanel>
        </controls:WizardSection>

        <Grid Visibility="{Binding CloudConnected, Converter={StaticResource BoolToVisibility}}">

            <!-- 1. Que se va a hacer -->
            <controls:WizardSection Number="1" Title="Que vas a hacer" IsDone="{Binding HasOperation}"
                                    Hint="Elige una opcion para seguir."
                                Visibility="{Binding SubStep, Converter={StaticResource ShowWhen}, ConverterParameter=1}"
                                controls:Motion.Entrance="True" controls:Motion.OffsetY="0" controls:Motion.OffsetX="{Binding SlideFrom}">
                <ListBox Style="{StaticResource ChoiceList}" ItemsSource="{Binding Operations}"
                         SelectedItem="{Binding SelectedOperation}" />
            </controls:WizardSection>

            <!-- 2. Tipo de servicio -->
            <controls:WizardSection Number="2" Title="Como se entrega el servicio" IsDone="{Binding HasServiceMode}"
                                    Hint="Define si la ONU hace de router con WiFi o solo pasa la senal."
                                Visibility="{Binding SubStep, Converter={StaticResource ShowWhen}, ConverterParameter=2}"
                                controls:Motion.Entrance="True" controls:Motion.OffsetY="0" controls:Motion.OffsetX="{Binding SlideFrom}">
                <ListBox Style="{StaticResource ChoiceList}" ItemsSource="{Binding ServiceModes}"
                         SelectedItem="{Binding SelectedServiceMode}" />
            </controls:WizardSection>

            <!-- 3. Cliente -->
            <controls:WizardSection Number="3" Title="{Binding ClientSectionTitle}" Hint="{Binding ClientSectionHint}"
                                    IsDone="{Binding HasClientIdentity}"
                                Visibility="{Binding SubStep, Converter={StaticResource ShowWhen}, ConverterParameter=3}"
                                controls:Motion.Entrance="True" controls:Motion.OffsetY="0" controls:Motion.OffsetX="{Binding SlideFrom}">
                <StackPanel>
                    <!-- Cliente nuevo: solo el nombre -->
                    <StackPanel Visibility="{Binding IsNewClient, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Nombre del servicio" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding ClientName, UpdateSourceTrigger=PropertyChanged, Delay=350}" />
                    </StackPanel>

                    <!-- Cliente existente: buscar y elegir -->
                    <StackPanel Visibility="{Binding IsNewClient, Converter={StaticResource InverseBoolToVisibility}}">
                        <TextBlock Text="Buscar" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding ClientSearch, UpdateSourceTrigger=PropertyChanged}" />
                        <ItemsControl ItemsSource="{Binding ClientResults}" Margin="0,10,0,0" MaxHeight="230">
                            <ItemsControl.Template>
                                <ControlTemplate TargetType="ItemsControl">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </ControlTemplate>
                            </ItemsControl.Template>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource GhostButton}" Margin="0,0,0,6"
                                            HorizontalContentAlignment="Stretch" MinHeight="50"
                                            controls:Motion.Entrance="True" controls:Motion.OffsetY="6"
                                            Command="{Binding DataContext.SelectClientCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}">
                                        <StackPanel HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding Display}" FontSize="13" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Detail}" FontSize="11.5" Foreground="{StaticResource InkSoft}" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Background="{StaticResource SuccessSoft}" CornerRadius="10" Padding="14,12" Margin="0,6,0,0"
                                Visibility="{Binding HasSelectedClient, Converter={StaticResource BoolToVisibility}}"
                                controls:Motion.Entrance="True">
                            <StackPanel>
                                <TextBlock Text="Cliente elegido" Style="{StaticResource Eyebrow}" Foreground="{StaticResource Success}" />
                                <TextBlock Text="{Binding SelectedClient.Display}" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{StaticResource Ink}" Margin="0,4,0,0" />
                                <TextBlock Text="{Binding SelectedClient.Detail}" Style="{StaticResource Body}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </controls:WizardSection>

            <!-- 4. Zona y plan -->
            <controls:WizardSection Number="4" Title="Zona y plan" IsDone="{Binding HasPlan}"
                                    Hint="Con el plan se ajusta sola la velocidad de subida y bajada."
                                Visibility="{Binding SubStep, Converter={StaticResource ShowWhen}, ConverterParameter=4}"
                                controls:Motion.Entrance="True" controls:Motion.OffsetY="0" controls:Motion.OffsetX="{Binding SlideFrom}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Zona" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding Zones}" SelectedItem="{Binding SelectedZone}"
                                      DisplayMemberPath="Name" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Plan" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding Plans}" SelectedItem="{Binding SelectedPlan}"
                                      DisplayMemberPath="Name" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,14,0,0" Visibility="{Binding HasPlan, Converter={StaticResource BoolToVisibility}}"
                          controls:Motion.Entrance="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="2*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Bajada (Mbps)" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding DownloadMbps, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Subida (Mbps)" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding UploadMbps, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="4" Visibility="{Binding NeedsPon, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="PON de destino" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding TargetPon, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </controls:WizardSection>

            <!-- 5. IP y expediente -->
            <controls:WizardSection Number="5" Title="IP y expediente" IsDone="{Binding IsReserved}"
                                    Hint="{Binding CloudNote}"
                                Visibility="{Binding SubStep, Converter={StaticResource ShowWhen}, ConverterParameter=5}"
                                controls:Motion.Entrance="True" controls:Motion.OffsetY="0" controls:Motion.OffsetX="{Binding SlideFrom}">
                <StackPanel>
                    <StackPanel Visibility="{Binding IsNewClient, Converter={StaticResource BoolToVisibility}}">
                        <Grid>
                            <Border Background="{StaticResource AccentSoft}" CornerRadius="10" Padding="16,12">
                                <StackPanel>
                                    <TextBlock Text="IP QUE VA A USAR" Style="{StaticResource Eyebrow}" Foreground="{StaticResource Accent}" />
                                    <TextBlock Text="{Binding SelectedIpText}" FontSize="16" FontWeight="SemiBold"
                                               Foreground="{StaticResource Accent}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                            <Button Content="Actualizar lista" Style="{StaticResource LinkButton}"
                                    HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"
                                    Command="{Binding RefreshIpsCommand}" />
                        </Grid>

                        <Expander Header="Elegir otra IP libre" Margin="0,10,0,0">
                            <ItemsControl ItemsSource="{Binding FreeIps}" Margin="0,8,0,0" MaxHeight="190">
                                <ItemsControl.Template>
                                    <ControlTemplate TargetType="ItemsControl">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <ItemsPresenter />
                                        </ScrollViewer>
                                    </ControlTemplate>
                                </ItemsControl.Template>
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource GhostButton}" Margin="0,0,8,8" MinHeight="36"
                                                Command="{Binding DataContext.PickIpCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}">
                                            <TextBlock Text="{Binding Ip}" FontFamily="{StaticResource MonoFont}" FontSize="12.5" />
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Content="{Binding ReserveLabel}" Style="{StaticResource PrimaryButton}"
                                Command="{Binding ReserveCommand}"
                                Visibility="{Binding IsReserved, Converter={StaticResource InverseBoolToVisibility}}" />
                        <Border Background="{StaticResource SuccessSoft}" CornerRadius="10" Padding="14,10"
                                Visibility="{Binding IsReserved, Converter={StaticResource BoolToVisibility}}"
                                controls:Motion.Entrance="True">
                            <TextBlock Text="Expediente abierto. Ya puedes continuar con internet." FontWeight="SemiBold"
                                       Foreground="{StaticResource Success}" />
                        </Border>
                    </StackPanel>
                </StackPanel>
            </controls:WizardSection>
        </Grid>
    </StackPanel>
</UserControl>
