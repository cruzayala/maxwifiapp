<UserControl x:Class="OnuStudio.App.Views.Wizard.ClientStepView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:OnuStudio.App.Controls">

    <!-- Paso 2: cliente, zona, plan e IP reservada en ISP Max. El DataContext es el WizardViewModel. -->
    <StackPanel>

        <Border Style="{StaticResource Card}"
                Visibility="{Binding CloudConnected, Converter={StaticResource InverseBoolToVisibility}}">
            <StackPanel>
                <TextBlock Text="Conecta ONU Studio con ISP Max" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="Con tu usuario de ISP Max. Esta PC queda recordada de forma segura."
                           Style="{StaticResource Body}" Margin="0,6,0,14" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Direccion de ISP Max" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding CloudUrl, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Usuario" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding CloudUsername, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Contrasena" Style="{StaticResource FieldLabel}" />
                        <PasswordBox controls:PasswordBoxAssistant.BoundPassword="{Binding CloudPassword, Mode=TwoWay}" />
                    </StackPanel>
                </Grid>
                <Button Content="Conectar" Style="{StaticResource PrimaryButton}"
                        Command="{Binding LoginCommand}" HorizontalAlignment="Left" Margin="0,16,0,0" />
            </StackPanel>
        </Border>

        <StackPanel Visibility="{Binding CloudConnected, Converter={StaticResource BoolToVisibility}}">
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Que vas a hacer" Style="{StaticResource SectionTitle}" />
                    <ListBox ItemsSource="{Binding Operations}" SelectedItem="{Binding Operation}"
                             Margin="0,12,0,0" BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Margin" Value="0,0,10,10" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Shape" Background="#FBFCFE" BorderBrush="{StaticResource Line}"
                                                    BorderThickness="1" CornerRadius="10" Padding="14,12" Cursor="Hand">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Shape" Property="BorderBrush" Value="#BBCEDF" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Shape" Property="BorderBrush" Value="{StaticResource Accent}" />
                                                    <Setter TargetName="Shape" Property="Background" Value="{StaticResource AccentSoft}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource Ink}" />
                                    <TextBlock Text="{Binding Detail}" FontSize="11.5"
                                               Foreground="{StaticResource InkSoft}" TextWrapping="Wrap"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="Cliente" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="Busca un cliente que ya existe o escribe el nombre del nuevo."
                               Style="{StaticResource Body}" Margin="0,6,0,12" />

                    <TextBox Text="{Binding ClientSearch, UpdateSourceTrigger=PropertyChanged}" />
                    <ItemsControl ItemsSource="{Binding ClientResults}" Margin="0,8,0,0" MaxHeight="220">
                        <ItemsControl.Template>
                            <ControlTemplate TargetType="ItemsControl">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource GhostButton}" Margin="0,0,0,6"
                                        HorizontalContentAlignment="Left" MinHeight="46"
                                        Command="{Binding DataContext.SelectClientCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Display}" FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Detail}" FontSize="11.5"
                                                   Foreground="{StaticResource InkSoft}" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Nombre del servicio" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding ClientName, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Zona" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding Zones}" SelectedItem="{Binding SelectedZone}"
                                      DisplayMemberPath="Name" />
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Plan" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding Plans}" SelectedItem="{Binding SelectedPlan}"
                                      DisplayMemberPath="Name" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="2*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Bajada (Mbps)" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding DownloadMbps, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Subida (Mbps)" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding UploadMbps, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="4" Visibility="{Binding NeedsPon, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="PON de destino" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding TargetPon, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="IP del cliente" Style="{StaticResource SectionTitle}" />
                        <Button Content="Actualizar lista" Style="{StaticResource LinkButton}"
                                HorizontalAlignment="Right" Command="{Binding RefreshIpsCommand}" />
                    </Grid>
                    <TextBlock Text="{Binding CloudNote}" Style="{StaticResource Body}" Margin="0,6,0,10" />

                    <Border Background="{StaticResource AccentSoft}" CornerRadius="8" Padding="14,10">
                        <TextBlock Text="{Binding SelectedIpText}" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource Accent}" />
                    </Border>

                    <ItemsControl ItemsSource="{Binding FreeIps}" Margin="0,10,0,0" MaxHeight="190">
                        <ItemsControl.Template>
                            <ControlTemplate TargetType="ItemsControl">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource GhostButton}" Margin="0,0,8,8" MinHeight="36"
                                        Command="{Binding DataContext.PickIpCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}">
                                    <TextBlock Text="{Binding Ip}" FontFamily="{StaticResource MonoFont}" FontSize="12.5" />
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Content="Reservar la IP y abrir el expediente" Style="{StaticResource PrimaryButton}"
                            Command="{Binding ReserveCommand}" HorizontalAlignment="Left" Margin="0,14,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </StackPanel>
</UserControl>
