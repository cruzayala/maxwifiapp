<UserControl x:Class="OnuStudio.App.Views.Wizard.InternetStepView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Paso 3: modo de servicio, VLAN y datos WAN. El DataContext es el WizardViewModel. -->
    <StackPanel>
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Conexion a internet" Style="{StaticResource SectionTitle}" />
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0">
                        <TextBlock Text="IP del cliente" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding WanIp, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="2">
                        <TextBlock Text="Mascara" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding WanMask, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="4">
                        <TextBlock Text="Puerta de enlace" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding WanGateway, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,14,0,0">
                        <TextBlock Text="VLAN" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding WanVlan, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,14,0,0">
                        <TextBlock Text="DNS principal" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding WanDns, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="4" Margin="0,14,0,0">
                        <TextBlock Text="DNS secundario" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding WanDnsSecondary, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Grid>

                <WrapPanel Margin="0,16,0,0">
                    <CheckBox Content="Compartir internet (NAT)" IsChecked="{Binding WanNat}" Margin="0,0,20,0" />
                    <CheckBox Content="Dar internet al WiFi" IsChecked="{Binding BindSsid1}" Margin="0,0,20,0" />
                    <CheckBox Content="Registrar en TR-069" IsChecked="{Binding Tr069Enabled}" />
                </WrapPanel>

                <TextBlock Text="Puertos LAN con internet" Style="{StaticResource FieldLabel}" Margin="0,16,0,6" />
                <WrapPanel>
                    <CheckBox Content="LAN1" IsChecked="{Binding Lan1}" Margin="0,0,16,0" />
                    <CheckBox Content="LAN2" IsChecked="{Binding Lan2}" Margin="0,0,16,0" />
                    <CheckBox Content="LAN3" IsChecked="{Binding Lan3}" Margin="0,0,16,0" />
                    <CheckBox Content="LAN4" IsChecked="{Binding Lan4}" />
                </WrapPanel>

                <TextBlock Text="Acceso remoto para soporte" Style="{StaticResource FieldLabel}" Margin="0,18,0,6" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="260" />
                    </Grid.ColumnDefinitions>
                    <CheckBox Grid.Column="0" Content="Permitir solo desde" IsChecked="{Binding RemoteEnabled}"
                              VerticalAlignment="Center" />
                    <TextBox Grid.Column="2" Text="{Binding RemoteSource, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>

                <Border Background="{StaticResource DangerSoft}" CornerRadius="8" Padding="12,10" Margin="0,16,0,0"
                        Visibility="{Binding HasInternetError, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding InternetError}" Foreground="{StaticResource Danger}"
                               FontSize="12.5" TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
