<UserControl x:Class="OnuStudio.App.Views.Wizard.ExpressStepView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:OnuStudio.App.Controls">

    <!-- Modo rapido en tres tarjetas: la ONU se lee sola, el tecnico pone nombre y plan,
         y todo se instala de una vez. El DataContext es el WizardViewModel. -->
    <UserControl.Resources>
        <!-- Cada paso de la lectura o la instalacion, con su icono segun como va -->
        <DataTemplate x:Key="TimelineItem">
            <Grid Margin="0,0,0,7" controls:Motion.Entrance="True" controls:Motion.OffsetY="0" controls:Motion.OffsetX="-12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid Width="16" Height="16" VerticalAlignment="Center">
                    <controls:Spinner x:Name="Busy" Width="14" Height="14" Thickness="2" Foreground="{StaticResource Accent}"
                                      Visibility="Collapsed" />
                    <Ellipse x:Name="Dot" Width="9" Height="9" Fill="{Binding Status, Converter={StaticResource Tone}}" />
                    <Path x:Name="Check" Data="M 3,8.5 L 6.5,12 L 13,4.5" Stroke="{StaticResource Success}" StrokeThickness="2.2"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed" />
                </Grid>
                <TextBlock Grid.Column="1" Text="{Binding Message}" FontSize="12.5" Foreground="{StaticResource Ink}"
                           TextWrapping="Wrap" VerticalAlignment="Center" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="running">
                    <Setter TargetName="Busy" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Dot" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="success">
                    <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Dot" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <ControlTemplate x:Key="ScrollingItems" TargetType="ItemsControl">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsPresenter />
            </ScrollViewer>
        </ControlTemplate>
    </UserControl.Resources>

    <Grid>

        <!-- ═══════════ 1. La ONU se lee sola ═══════════ -->
        <controls:WizardSection Number="1" Title="{Binding ExpressReadTitle}" Hint="{Binding ExpressReadHint}"
                                IsDone="{Binding DeviceReady}"
                                Visibility="{Binding Step, Converter={StaticResource ShowWhen}, ConverterParameter=1}"
                                controls:Motion.Entrance="True" controls:Motion.OffsetY="0"
                                controls:Motion.OffsetX="{Binding SlideFrom}">
            <StackPanel>

                <!-- Que ve la busqueda mientras no hay ONU o aun no se lee -->
                <Border Background="{Binding DiscoveryTone, Converter={StaticResource ToneSoft}}" CornerRadius="12" Padding="20,18"
                        Visibility="{Binding ShowDiscoveryCard, Converter={StaticResource BoolToVisibility}}">
                    <DockPanel>
                        <Grid Width="22" Height="22" VerticalAlignment="Top" Margin="0,2,0,0" DockPanel.Dock="Left">
                            <Ellipse Fill="{Binding DiscoveryTone, Converter={StaticResource Tone}}" Opacity="0.3"
                                     controls:Motion.Pulse="True" />
                            <Ellipse Width="12" Height="12" Fill="{Binding DiscoveryTone, Converter={StaticResource Tone}}" />
                        </Grid>
                        <Button Content="Buscar de nuevo" Style="{StaticResource GhostButton}" DockPanel.Dock="Right"
                                MinHeight="36" Padding="14,0" VerticalAlignment="Center" Command="{Binding ScanCommand}" />
                        <StackPanel Margin="14,0,14,0">
                            <TextBlock Text="{Binding DiscoveryTitle}" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{Binding DiscoveryTone, Converter={StaticResource Tone}}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding DiscoveryDetail}" Style="{StaticResource Body}" Margin="0,4,0,0" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Animacion de carga: anillo grande y los pasos de la lectura marcandose -->
                <Border Background="{StaticResource AccentSoft}" CornerRadius="14" Padding="24,22"
                        Visibility="{Binding IsReading, Converter={StaticResource BoolToVisibility}}"
                        controls:Motion.Entrance="True">
                    <DockPanel>
                        <Grid Width="76" Height="76" DockPanel.Dock="Left" VerticalAlignment="Top">
                            <Ellipse Fill="{StaticResource Accent}" Opacity="0.14" controls:Motion.Pulse="True" />
                            <controls:Spinner Width="54" Height="54" Thickness="4.5" Foreground="{StaticResource Accent}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <StackPanel Margin="22,4,0,0">
                            <TextBlock Text="{Binding BusyMessage}" FontSize="15.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentDark}" TextWrapping="Wrap" />
                            <TextBlock Text="Tarda unos segundos. No desconectes el cable." Style="{StaticResource Body}" Margin="0,3,0,0" />
                            <ItemsControl ItemsSource="{Binding Timeline}" ItemTemplate="{StaticResource TimelineItem}"
                                          Margin="0,14,0,0" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Resultado: lo que reporta la ONU -->
                <StackPanel Visibility="{Binding ShowReadResult, Converter={StaticResource BoolToVisibility}}">
                    <Border Background="{StaticResource SuccessSoft}" CornerRadius="12" Padding="18,14"
                            controls:Motion.Entrance="True">
                        <DockPanel>
                            <Grid Width="34" Height="34" DockPanel.Dock="Left" VerticalAlignment="Center">
                                <Ellipse Fill="{StaticResource Success}" />
                                <Path Data="M 10,17.5 L 14.5,22 L 24,12" Stroke="White" StrokeThickness="2.8"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                            </Grid>
                            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ModelLabel}" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
                                <TextBlock Text="Leida y confirmada. Paso al cliente en un momento." Style="{StaticResource Body}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <UniformGrid Columns="3" Margin="0,14,0,0">
                        <Border Style="{StaticResource SoftCard}" Margin="0,0,10,0" controls:Motion.Entrance="True" controls:Motion.Delay="60">
                            <StackPanel>
                                <TextBlock Text="SERIAL GPON" Style="{StaticResource Eyebrow}" />
                                <TextBlock Text="{Binding Serial}" Style="{StaticResource Mono}" FontSize="14" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SoftCard}" Margin="0,0,10,0" controls:Motion.Entrance="True" controls:Motion.Delay="140">
                            <StackPanel>
                                <TextBlock Text="FIRMWARE" Style="{StaticResource Eyebrow}" />
                                <TextBlock Text="{Binding Firmware}" FontSize="14" Foreground="{StaticResource Ink}" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SoftCard}" controls:Motion.Entrance="True" controls:Motion.Delay="220">
                            <StackPanel>
                                <TextBlock Text="SENAL OPTICA" Style="{StaticResource Eyebrow}" />
                                <TextBlock Text="{Binding OpticalSummary}" FontSize="13.5" Foreground="{StaticResource Ink}"
                                           TextWrapping="Wrap" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </StackPanel>

                <!-- No se pudo leer -->
                <Border Background="{StaticResource DangerSoft}" CornerRadius="12" Padding="18,14"
                        Visibility="{Binding ReadFailed, Converter={StaticResource BoolToVisibility}}"
                        controls:Motion.Entrance="True">
                    <StackPanel>
                        <TextBlock Text="{Binding ReadError}" FontWeight="SemiBold" Foreground="{StaticResource Danger}" TextWrapping="Wrap" />
                        <Button Content="Leer la ONU de nuevo" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"
                                Margin="0,12,0,0" Command="{Binding CheckCommand}" />
                    </StackPanel>
                </Border>

                <!-- Ajustes a mano, por si la ONU no es la de fabrica -->
                <Expander Header="Ajustar la conexion a mano" Margin="0,16,0,0" IsExpanded="{Binding ShowConnectionSettings}"
                          Visibility="{Binding IsReading, Converter={StaticResource InverseBoolToVisibility}}">
                    <Border Style="{StaticResource SoftCard}" Margin="0,8,0,0">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Grid.Column="0">
                                    <TextBlock Text="Tarjeta de red" Style="{StaticResource FieldLabel}" />
                                    <ComboBox ItemsSource="{Binding Adapters}" SelectedItem="{Binding SelectedAdapter}" DisplayMemberPath="DisplayName" />
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="2">
                                    <TextBlock Text="Modelo de la ONU" Style="{StaticResource FieldLabel}" />
                                    <ComboBox ItemsSource="{Binding Models}" SelectedItem="{Binding DeviceModel}" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,14,0,0">
                                    <TextBlock Text="IP de la ONU" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding DeviceHost, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,14,0,0">
                                    <TextBlock Text="IP que usa la PC" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding LocalAddress, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,14,0,0">
                                    <TextBlock Text="Usuario tecnico (opcional)" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding DeviceUser, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="Si lo dejas vacio se usa el guardado en Ajustes." Style="{StaticResource Hint}" />
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,14,0,0">
                                    <TextBlock Text="Contrasena tecnica (opcional)" Style="{StaticResource FieldLabel}" />
                                    <PasswordBox controls:PasswordBoxAssistant.BoundPassword="{Binding DevicePassword, Mode=TwoWay}" />
                                </StackPanel>
                            </Grid>
                            <Button Content="Leer la ONU" Style="{StaticResource GhostButton}" HorizontalAlignment="Left"
                                    Margin="0,14,0,0" Command="{Binding CheckCommand}" />
                        </StackPanel>
                    </Border>
                </Expander>
            </StackPanel>
        </controls:WizardSection>

        <!-- ═══════════ 2. Cliente y plan; lo demas se pone solo ═══════════ -->
        <StackPanel Visibility="{Binding Step, Converter={StaticResource ShowWhen}, ConverterParameter=2}">

            <!-- Sin sesion con ISP Max no se puede instalar -->
            <controls:WizardSection Number="!" Title="Conecta ONU Studio con ISP Max"
                                    Hint="Con tu usuario de ISP Max. Esta PC queda recordada de forma segura."
                                    Visibility="{Binding CloudConnected, Converter={StaticResource InverseBoolToVisibility}}"
                                    controls:Motion.Entrance="True" controls:Motion.OffsetY="0" controls:Motion.OffsetX="{Binding SlideFrom}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Direccion de ISP Max" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding CloudUrl, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Usuario" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding CloudUsername, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Contrasena" Style="{StaticResource FieldLabel}" />
                            <PasswordBox controls:PasswordBoxAssistant.BoundPassword="{Binding CloudPassword, Mode=TwoWay}" />
                        </StackPanel>
                    </Grid>
                    <Button Content="Conectar" Style="{StaticResource PrimaryButton}" MinWidth="140"
                            Command="{Binding LoginCommand}" HorizontalAlignment="Left" Margin="0,16,0,0" />
                </StackPanel>
            </controls:WizardSection>

            <controls:WizardSection Number="2" Title="Cliente" IsDone="{Binding CanInstall}"
                                    Hint="Escribe el nombre y elige el plan. La IP, el WiFi y la clave los pongo yo; cambialos solo si hace falta."
                                    Visibility="{Binding CloudConnected, Converter={StaticResource BoolToVisibility}}"
                                    controls:Motion.Entrance="True" controls:Motion.OffsetY="0" controls:Motion.OffsetX="{Binding SlideFrom}">
                <StackPanel>
                    <TextBlock Text="Nombre del cliente" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding ExpressName, UpdateSourceTrigger=PropertyChanged, Delay=250}" FontSize="16" MinHeight="44" />

                    <!-- Si ya existe en ISP Max, se ofrece para reconfigurar su ONU -->
                    <Border Style="{StaticResource SoftCard}" Padding="12,10" Margin="0,8,0,0"
                            Visibility="{Binding HasExpressMatches, Converter={StaticResource BoolToVisibility}}"
                            controls:Motion.Entrance="True" controls:Motion.OffsetY="6">
                        <StackPanel>
                            <TextBlock Text="YA EXISTE EN ISP MAX · ELIGELO SI ES EL MISMO CLIENTE" Style="{StaticResource Eyebrow}" Margin="0,0,0,6" />
                            <ItemsControl ItemsSource="{Binding ClientResults}" MaxHeight="200" Template="{StaticResource ScrollingItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource GhostButton}" Margin="0,0,0,6" HorizontalContentAlignment="Stretch" MinHeight="46"
                                                Command="{Binding DataContext.ExpressSelectClientCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}">
                                            <StackPanel HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding Display}" FontSize="13" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Detail}" FontSize="11.5" Foreground="{StaticResource InkSoft}" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource SuccessSoft}" CornerRadius="10" Padding="14,12" Margin="0,8,0,0"
                            Visibility="{Binding HasSelectedClient, Converter={StaticResource BoolToVisibility}}"
                            controls:Motion.Entrance="True">
                        <DockPanel>
                            <Button Content="Es un cliente nuevo" Style="{StaticResource LinkButton}" DockPanel.Dock="Right"
                                    VerticalAlignment="Center" Command="{Binding ExpressNewClientCommand}" />
                            <StackPanel>
                                <TextBlock Text="{Binding SelectedClient.Display}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
                                <TextBlock Text="{Binding ExpressClientNote}" Style="{StaticResource Body}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Zona y plan: solo para el cliente nuevo -->
                    <Grid Margin="0,16,0,0" Visibility="{Binding IsNewClient, Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Zona" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding Zones}" SelectedItem="{Binding SelectedZone}" DisplayMemberPath="Name" />
                            <TextBlock Text="Queda propuesta la del ultimo cliente." Style="{StaticResource Hint}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Plan" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding Plans}" SelectedItem="{Binding SelectedPlan}" DisplayMemberPath="Name" />
                            <TextBlock Text="Con el plan se ajusta sola la velocidad." Style="{StaticResource Hint}" />
                        </StackPanel>
                    </Grid>

                    <!-- Lo que el agente decide solo; se puede cambiar -->
                    <Border Background="{StaticResource AccentSoft}" CornerRadius="12" Padding="18,14" Margin="0,18,0,0">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Text="{Binding CloudNote}" Style="{StaticResource Hint}" Margin="0" DockPanel.Dock="Right"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="LO PONGO YO" Style="{StaticResource Eyebrow}" Foreground="{StaticResource Accent}" />
                            </DockPanel>
                            <UniformGrid Columns="3" Margin="0,10,0,0">
                                <StackPanel Margin="0,0,14,0">
                                    <TextBlock Text="IP del cliente" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Text="{Binding ExpressIpText}" Style="{StaticResource Mono}" FontSize="15" Margin="0,8,0,0" />
                                    <Expander Header="Elegir otra IP libre" Margin="0,8,0,0"
                                              Visibility="{Binding IsNewClient, Converter={StaticResource BoolToVisibility}}">
                                        <ItemsControl ItemsSource="{Binding FreeIps}" Margin="0,8,0,0" MaxHeight="160" Template="{StaticResource ScrollingItems}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource GhostButton}" Margin="0,0,6,6" MinHeight="32" Padding="10,0"
                                                            Command="{Binding DataContext.PickIpCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}">
                                                        <TextBlock Text="{Binding Ip}" FontFamily="{StaticResource MonoFont}" FontSize="12" />
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Expander>
                                </StackPanel>
                                <StackPanel Margin="0,0,14,0">
                                    <TextBlock Text="Nombre del WiFi" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding WifiSsid, UpdateSourceTrigger=PropertyChanged, Delay=300}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Clave del WiFi" Style="{StaticResource FieldLabel}" />
                                    <DockPanel>
                                        <Button Content="Otra" Style="{StaticResource LinkButton}" DockPanel.Dock="Right" Margin="8,0,0,0"
                                                VerticalAlignment="Center" Command="{Binding GenerateWifiCommand}" />
                                        <TextBox Text="{Binding WifiPassword, UpdateSourceTrigger=PropertyChanged, Delay=300}"
                                                 FontFamily="{StaticResource MonoFont}" />
                                    </DockPanel>
                                </StackPanel>
                            </UniformGrid>
                            <TextBlock Text="{Binding InstallBlocker}" Style="{StaticResource Hint}" Foreground="{StaticResource Warning}"
                                       FontWeight="SemiBold" Margin="0,12,0,0"
                                       Visibility="{Binding InstallBlocker, Converter={StaticResource TextToVisibility}}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </controls:WizardSection>
        </StackPanel>

        <!-- ═══════════ 3. Instalar de una vez ═══════════ -->
        <controls:WizardSection Number="3" Title="{Binding ExpressInstallTitle}" Hint="{Binding ExpressInstallHint}"
                                IsDone="{Binding Finished}"
                                Visibility="{Binding Step, Converter={StaticResource ShowWhen}, ConverterParameter=3}"
                                controls:Motion.Entrance="True" controls:Motion.OffsetY="0"
                                controls:Motion.OffsetX="{Binding SlideFrom}">
            <StackPanel>

                <!-- Avance -->
                <DockPanel Visibility="{Binding Finished, Converter={StaticResource InverseBoolToVisibility}}">
                    <Grid Width="68" Height="68" DockPanel.Dock="Left" VerticalAlignment="Center"
                          Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                        <Ellipse Fill="{StaticResource Accent}" Opacity="0.14" controls:Motion.Pulse="True" />
                        <controls:Spinner Width="48" Height="48" Thickness="4" Foreground="{StaticResource Accent}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <StackPanel Margin="18,0,0,0" VerticalAlignment="Center">
                        <Grid>
                            <TextBlock Text="{Binding ProgressLabel}" Style="{StaticResource SectionTitle}" FontSize="15" Margin="0,0,60,0" />
                            <TextBlock Text="{Binding Progress, StringFormat={}{0}%}" HorizontalAlignment="Right" Style="{StaticResource Body}" />
                        </Grid>
                        <ProgressBar controls:Motion.SmoothValue="{Binding Progress, Mode=OneWay}" Maximum="100" Margin="0,10,0,0" />
                    </StackPanel>
                </DockPanel>

                <!-- Fallo -->
                <Border Background="{StaticResource DangerSoft}" CornerRadius="10" Padding="14,12" Margin="0,14,0,0"
                        Visibility="{Binding Failed, Converter={StaticResource BoolToVisibility}}" controls:Motion.Entrance="True">
                    <TextBlock Text="{Binding ProgressLabel}" FontWeight="SemiBold" Foreground="{StaticResource Danger}" TextWrapping="Wrap" />
                </Border>

                <!-- Listo: lo que se le entrega al cliente -->
                <Border Background="{StaticResource SuccessSoft}" CornerRadius="14" Padding="22,18"
                        Visibility="{Binding Finished, Converter={StaticResource BoolToVisibility}}" controls:Motion.Entrance="True">
                    <StackPanel>
                        <TextBlock Text="ENTREGA ESTOS DATOS AL CLIENTE" Style="{StaticResource Eyebrow}" Foreground="{StaticResource Success}" />
                        <UniformGrid Columns="2" Margin="0,12,0,0">
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="Red WiFi" Style="{StaticResource FieldLabel}" />
                                <TextBlock Text="{Binding WifiSsid}" FontFamily="{StaticResource DisplayFont}" FontSize="24" FontWeight="SemiBold"
                                           Foreground="{StaticResource Ink}" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Clave" Style="{StaticResource FieldLabel}" />
                                <TextBlock Text="{Binding WifiPassword}" FontFamily="{StaticResource MonoFont}" FontSize="24"
                                           Foreground="{StaticResource Ink}" TextWrapping="Wrap" />
                            </StackPanel>
                        </UniformGrid>
                        <TextBlock Text="{Binding ExpressDeliverySummary}" Style="{StaticResource Body}" Margin="0,14,0,0" />
                    </StackPanel>
                </Border>

                <ItemsControl ItemsSource="{Binding Timeline}" ItemTemplate="{StaticResource TimelineItem}"
                              Template="{StaticResource ScrollingItems}" Margin="0,18,0,0" MaxHeight="260" />
            </StackPanel>
        </controls:WizardSection>
    </Grid>
</UserControl>
