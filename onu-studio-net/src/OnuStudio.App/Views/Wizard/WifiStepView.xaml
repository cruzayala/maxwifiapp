<UserControl x:Class="OnuStudio.App.Views.Wizard.WifiStepView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:OnuStudio.App.Controls">

    <!-- Paso 4: nombre de la red, luego la clave y al final las opciones. -->
    <StackPanel>

        <!-- En bridge no hay WiFi que configurar -->
        <controls:WizardSection Number="✓" Title="Sin WiFi en modo bridge" IsDone="True"
                                Hint="La ONU solo pasa la senal; el WiFi lo da el router del cliente. Puedes continuar."
                                Visibility="{Binding IsBridgeMode, Converter={StaticResource BoolToVisibility}}"
                                controls:Motion.Entrance="True" controls:Motion.OffsetY="0" controls:Motion.OffsetX="{Binding SlideFrom}">
            <TextBlock Text="Nada que configurar aqui." Style="{StaticResource Body}" />
        </controls:WizardSection>

        <Grid Visibility="{Binding IsRouterMode, Converter={StaticResource BoolToVisibility}}">

            <!-- 1. Nombre -->
            <controls:WizardSection Number="1" Title="Nombre de la red" IsDone="{Binding HasSsid}"
                                    Hint="Lo propongo a partir del cliente; cambialo si quieres."
                                Visibility="{Binding SubStep, Converter={StaticResource ShowWhen}, ConverterParameter=1}"
                                controls:Motion.Entrance="True" controls:Motion.OffsetY="0" controls:Motion.OffsetX="{Binding SlideFrom}">
                <TextBox Text="{Binding WifiSsid, UpdateSourceTrigger=PropertyChanged, Delay=300}" FontSize="15"
                         MaxWidth="460" HorizontalAlignment="Left" MinWidth="360" />
            </controls:WizardSection>

            <!-- 2. Clave -->
            <controls:WizardSection Number="2" Title="Clave del WiFi" IsDone="{Binding HasWifiPassword}"
                                    Hint="Minimo 8 caracteres. Genera una segura con un clic."
                                Visibility="{Binding SubStep, Converter={StaticResource ShowWhen}, ConverterParameter=2}"
                                controls:Motion.Entrance="True" controls:Motion.OffsetY="0" controls:Motion.OffsetX="{Binding SlideFrom}">
                <StackPanel Orientation="Horizontal">
                    <TextBox Text="{Binding WifiPassword, UpdateSourceTrigger=PropertyChanged, Delay=300}"
                             FontFamily="{StaticResource MonoFont}" FontSize="15" MinWidth="300" />
                    <Button Content="Generar clave" Style="{StaticResource GhostButton}" Margin="12,0,0,0"
                            Command="{Binding GenerateWifiCommand}" />
                </StackPanel>
            </controls:WizardSection>

            <!-- 3. Opciones -->
            <controls:WizardSection Number="3" Title="Listo. Opciones del WiFi" IsDone="True"
                                    Hint="Ya esta bien asi; abre las opciones solo si el cliente pide algo especial."
                                Visibility="{Binding SubStep, Converter={StaticResource ShowWhen}, ConverterParameter=3}"
                                controls:Motion.Entrance="True" controls:Motion.OffsetY="0" controls:Motion.OffsetX="{Binding SlideFrom}">
                <Expander Header="Opciones avanzadas">
                    <StackPanel Margin="0,8,0,0">
                        <WrapPanel>
                            <CheckBox Content="WiFi encendido" IsChecked="{Binding WifiEnabled}" Margin="0,0,20,0" />
                            <CheckBox Content="Mostrar el nombre de la red" IsChecked="{Binding WifiBroadcast}" Margin="0,0,20,0" />
                            <CheckBox Content="Prioridad de video y voz (WMM)" IsChecked="{Binding WifiWmm}" Margin="0,0,20,0" />
                            <CheckBox Content="Permitir WPS" IsChecked="{Binding WifiWps}" />
                        </WrapPanel>
                        <StackPanel Margin="0,14,0,0" Width="220" HorizontalAlignment="Left">
                            <TextBlock Text="Maximo de equipos" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding WifiMaxClients, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </StackPanel>
                </Expander>
            </controls:WizardSection>

        </Grid>
    </StackPanel>
</UserControl>
