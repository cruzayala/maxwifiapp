<UserControl x:Class="OnuStudio.App.Views.DeviceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}">

    <Grid>
        <!-- Aun no se ha leido ninguna ONU -->
        <Border Style="{StaticResource Card}" Margin="32,28" VerticalAlignment="Top" MaxWidth="620"
                HorizontalAlignment="Left"
                Visibility="{Binding HasData, Converter={StaticResource InverseBoolToVisibility}}">
            <StackPanel>
                <TextBlock Text="Todavia no hay lectura" Style="{StaticResource SectionTitle}" />
                <TextBlock Style="{StaticResource Body}" Margin="0,8,0,0"
                           Text="Ve a Configurar una ONU y pulsa «Leer la ONU». Aqui apareceran su serial, su firmware, la senal optica, la conexion a internet, los puertos y el WiFi." />
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,24"
                      Visibility="{Binding HasData, Converter={StaticResource BoolToVisibility}}">
            <StackPanel MaxWidth="1040" HorizontalAlignment="Left">
                <TextBlock Text="{Binding CollectedAt}" Style="{StaticResource Body}" Margin="0,0,0,14" />

                <ItemsControl ItemsSource="{Binding Groups}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Margin="0,0,14,14" VerticalAlignment="Top">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitle}" FontSize="14" />
                                    <ItemsControl ItemsSource="{Binding Rows}" Margin="0,12,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,9">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="170" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Label}"
                                                               FontSize="12" Foreground="{StaticResource InkSoft}"
                                                               TextWrapping="Wrap" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Value}"
                                                               FontSize="12.5" Foreground="{StaticResource Ink}"
                                                               FontWeight="SemiBold" TextWrapping="Wrap" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
