<UserControl x:Class="OnuStudio.App.Views.WizardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:OnuStudio.App.Controls"
             FontFamily="{StaticResource UiFont}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ── Pasos ── -->
        <Border Grid.Row="0" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                BorderThickness="0,0,0,1" Padding="32,14">
            <ItemsControl ItemsSource="{Binding Steps}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border CornerRadius="20" Padding="14,7" Margin="0,0,8,0"
                                Background="{Binding Tone, Converter={StaticResource ToneSoft}}">
                            <TextBlock Text="{Binding Label}" FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{Binding Tone, Converter={StaticResource Tone}}" />
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <!-- ── Contenido del paso ── -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="32,24">
            <StackPanel MaxWidth="980" HorizontalAlignment="Left">

                <TextBlock Text="{Binding StepTitle}" Style="{StaticResource PageTitle}" FontSize="20" />
                <TextBlock Text="{Binding StepHint}" Style="{StaticResource Body}" Margin="0,6,0,18" />

                <!-- ══ Paso 1: detectar ══ -->
                <StackPanel Visibility="{Binding IsStep1, Converter={StaticResource BoolToVisibility}}">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="10" Height="10" VerticalAlignment="Center"
                                         Fill="{Binding DiscoveryTone, Converter={StaticResource Tone}}" />
                                <TextBlock Text="{Binding DiscoveryTitle}" Style="{StaticResource SectionTitle}"
                                           Margin="10,0,0,0" />
                            </StackPanel>
                            <TextBlock Text="{Binding DiscoveryDetail}" Style="{StaticResource Body}" Margin="20,8,0,0" />

                            <UniformGrid Columns="3" Margin="0,18,0,0"
                                         Visibility="{Binding HasSerial, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel Margin="0,0,14,0">
                                    <TextBlock Text="SERIAL GPON" Style="{StaticResource Eyebrow}" />
                                    <TextBlock Text="{Binding Serial}" Style="{StaticResource Mono}" Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel Margin="0,0,14,0">
                                    <TextBlock Text="FIRMWARE" Style="{StaticResource Eyebrow}" />
                                    <TextBlock Text="{Binding Firmware}" Style="{StaticResource Body}" Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="SENAL OPTICA" Style="{StaticResource Eyebrow}" />
                                    <TextBlock Text="{Binding OpticalSummary}" Style="{StaticResource Body}" Margin="0,4,0,0" />
                                </StackPanel>
                            </UniformGrid>

                            <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                                <Button Content="Leer la ONU" Style="{StaticResource PrimaryButton}"
                                        Command="{Binding CheckCommand}" />
                                <Button Content="Buscar de nuevo" Style="{StaticResource GhostButton}"
                                        Command="{Binding ScanCommand}" Margin="10,0,0,0" />
                            </StackPanel>
                            <TextBlock Text="{Binding BusyMessage}" Style="{StaticResource Hint}"
                                       Visibility="{Binding BusyMessage, Converter={StaticResource TextToVisibility}}" />
                        </StackPanel>
                    </Border>

                    <Expander Header="Ajustar la conexion con la ONU" Margin="0,14,0,0" Foreground="{StaticResource InkMuted}">
                        <Border Style="{StaticResource SoftCard}" Margin="0,10,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0">
                                    <TextBlock Text="Tarjeta de red" Style="{StaticResource FieldLabel}" />
                                    <ComboBox ItemsSource="{Binding Adapters}" SelectedItem="{Binding SelectedAdapter}"
                                              DisplayMemberPath="DisplayName" />
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="2">
                                    <TextBlock Text="Modelo de la ONU" Style="{StaticResource FieldLabel}" />
                                    <ComboBox ItemsSource="{Binding Models}" SelectedItem="{Binding DeviceModel}" />
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,14,0,0">
                                    <TextBlock Text="IP de la ONU" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding DeviceHost, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,14,0,0">
                                    <TextBlock Text="IP que usa la PC" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding LocalAddress, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,14,0,0">
                                    <TextBlock Text="Usuario tecnico (opcional)" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding DeviceUser, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="Si lo dejas vacio se usa el guardado en Ajustes." Style="{StaticResource Hint}" />
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,14,0,0">
                                    <TextBlock Text="Contrasena tecnica (opcional)" Style="{StaticResource FieldLabel}" />
                                    <PasswordBox controls:PasswordBoxAssistant.BoundPassword="{Binding DevicePassword, Mode=TwoWay}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Expander>
                </StackPanel>

                <!-- ══ Paso 2: cliente e IP ══ -->
                <StackPanel Visibility="{Binding IsStep2, Converter={StaticResource BoolToVisibility}}">

                    <Border Style="{StaticResource Card}"
                            Visibility="{Binding CloudConnected, Converter={StaticResource InverseBoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="Conecta ONU Studio con ISP Max" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="Con tu usuario de ISP Max. Esta PC queda recordada de forma segura."
                                       Style="{StaticResource Body}" Margin="0,6,0,14" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Direccion de ISP Max" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding CloudUrl, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Usuario" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding CloudUsername, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Contrasena" Style="{StaticResource FieldLabel}" />
                                    <PasswordBox controls:PasswordBoxAssistant.BoundPassword="{Binding CloudPassword, Mode=TwoWay}" />
                                </StackPanel>
                            </Grid>
                            <Button Content="Conectar" Style="{StaticResource PrimaryButton}"
                                    Command="{Binding LoginCommand}" HorizontalAlignment="Left" Margin="0,16,0,0" />
                        </StackPanel>
                    </Border>

                    <StackPanel Visibility="{Binding CloudConnected, Converter={StaticResource BoolToVisibility}}">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Que vas a hacer" Style="{StaticResource SectionTitle}" />
                                <ListBox ItemsSource="{Binding Operations}" SelectedItem="{Binding Operation}"
                                         Margin="0,12,0,0" BorderThickness="0" Background="Transparent"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="2" />
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Margin" Value="0,0,10,10" />
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border x:Name="Shape" Background="#FBFCFE" BorderBrush="{StaticResource Line}"
                                                                BorderThickness="1" CornerRadius="10" Padding="14,12" Cursor="Hand">
                                                            <ContentPresenter />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Shape" Property="BorderBrush" Value="#BBCEDF" />
                                                            </Trigger>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="Shape" Property="BorderBrush" Value="{StaticResource Accent}" />
                                                                <Setter TargetName="Shape" Property="Background" Value="{StaticResource AccentSoft}" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold"
                                                           Foreground="{StaticResource Ink}" />
                                                <TextBlock Text="{Binding Detail}" FontSize="11.5"
                                                           Foreground="{StaticResource InkSoft}" TextWrapping="Wrap"
                                                           Margin="0,4,0,0" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="Cliente" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="Busca un cliente que ya existe o escribe el nombre del nuevo."
                                           Style="{StaticResource Body}" Margin="0,6,0,12" />

                                <TextBox Text="{Binding ClientSearch, UpdateSourceTrigger=PropertyChanged}" />
                                <ItemsControl ItemsSource="{Binding ClientResults}" Margin="0,8,0,0" MaxHeight="220">
                                    <ItemsControl.Template>
                                        <ControlTemplate TargetType="ItemsControl">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                <ItemsPresenter />
                                            </ScrollViewer>
                                        </ControlTemplate>
                                    </ItemsControl.Template>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource GhostButton}" Margin="0,0,0,6"
                                                    HorizontalContentAlignment="Left" MinHeight="46"
                                                    Command="{Binding DataContext.SelectClientCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Display}" FontSize="13" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Detail}" FontSize="11.5"
                                                               Foreground="{StaticResource InkSoft}" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Nombre del servicio" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding ClientName, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Zona" Style="{StaticResource FieldLabel}" />
                                        <ComboBox ItemsSource="{Binding Zones}" SelectedItem="{Binding SelectedZone}"
                                                  DisplayMemberPath="Name" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="Plan" Style="{StaticResource FieldLabel}" />
                                        <ComboBox ItemsSource="{Binding Plans}" SelectedItem="{Binding SelectedPlan}"
                                                  DisplayMemberPath="Name" />
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="2*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Bajada (Mbps)" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding DownloadMbps, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Subida (Mbps)" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding UploadMbps, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="4" Visibility="{Binding NeedsPon, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="PON de destino" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding TargetPon, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="IP del cliente" Style="{StaticResource SectionTitle}" />
                                    <Button Content="Actualizar lista" Style="{StaticResource LinkButton}"
                                            HorizontalAlignment="Right" Command="{Binding RefreshIpsCommand}" />
                                </Grid>
                                <TextBlock Text="{Binding CloudNote}" Style="{StaticResource Body}" Margin="0,6,0,10" />

                                <Border Background="{StaticResource AccentSoft}" CornerRadius="8" Padding="14,10">
                                    <TextBlock Text="{Binding SelectedIpText}" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{StaticResource Accent}" />
                                </Border>

                                <ItemsControl ItemsSource="{Binding FreeIps}" Margin="0,10,0,0" MaxHeight="190">
                                    <ItemsControl.Template>
                                        <ControlTemplate TargetType="ItemsControl">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                <ItemsPresenter />
                                            </ScrollViewer>
                                        </ControlTemplate>
                                    </ItemsControl.Template>
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource GhostButton}" Margin="0,0,8,8" MinHeight="36"
                                                    Command="{Binding DataContext.PickIpCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}">
                                                <TextBlock Text="{Binding Ip}" FontFamily="{StaticResource MonoFont}" FontSize="12.5" />
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Button Content="Reservar la IP y abrir el expediente" Style="{StaticResource PrimaryButton}"
                                        Command="{Binding ReserveCommand}" HorizontalAlignment="Left" Margin="0,14,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- ══ Paso 3: internet ══ -->
                <StackPanel Visibility="{Binding IsStep3, Converter={StaticResource BoolToVisibility}}">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Conexion a internet" Style="{StaticResource SectionTitle}" />
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0">
                                    <TextBlock Text="IP del cliente" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding WanIp, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="2">
                                    <TextBlock Text="Mascara" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding WanMask, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="4">
                                    <TextBlock Text="Puerta de enlace" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding WanGateway, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,14,0,0">
                                    <TextBlock Text="VLAN" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding WanVlan, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,14,0,0">
                                    <TextBlock Text="DNS principal" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding WanDns, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="4" Margin="0,14,0,0">
                                    <TextBlock Text="DNS secundario" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding WanDnsSecondary, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>

                            <WrapPanel Margin="0,16,0,0">
                                <CheckBox Content="Compartir internet (NAT)" IsChecked="{Binding WanNat}" Margin="0,0,20,0" />
                                <CheckBox Content="Dar internet al WiFi" IsChecked="{Binding BindSsid1}" Margin="0,0,20,0" />
                                <CheckBox Content="Registrar en TR-069" IsChecked="{Binding Tr069Enabled}" />
                            </WrapPanel>

                            <TextBlock Text="Puertos LAN con internet" Style="{StaticResource FieldLabel}" Margin="0,16,0,6" />
                            <WrapPanel>
                                <CheckBox Content="LAN1" IsChecked="{Binding Lan1}" Margin="0,0,16,0" />
                                <CheckBox Content="LAN2" IsChecked="{Binding Lan2}" Margin="0,0,16,0" />
                                <CheckBox Content="LAN3" IsChecked="{Binding Lan3}" Margin="0,0,16,0" />
                                <CheckBox Content="LAN4" IsChecked="{Binding Lan4}" />
                            </WrapPanel>

                            <TextBlock Text="Acceso remoto para soporte" Style="{StaticResource FieldLabel}" Margin="0,18,0,6" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="260" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" Content="Permitir solo desde" IsChecked="{Binding RemoteEnabled}"
                                          VerticalAlignment="Center" />
                                <TextBox Grid.Column="2" Text="{Binding RemoteSource, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>

                            <Border Background="{StaticResource DangerSoft}" CornerRadius="8" Padding="12,10" Margin="0,16,0,0"
                                    Visibility="{Binding HasInternetError, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding InternetError}" Foreground="{StaticResource Danger}"
                                           FontSize="12.5" TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ══ Paso 4: WiFi ══ -->
                <StackPanel Visibility="{Binding IsStep4, Converter={StaticResource BoolToVisibility}}">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Red WiFi del cliente" Style="{StaticResource SectionTitle}" />
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Nombre de la red" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding WifiSsid, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Clave" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding WifiPassword, UpdateSourceTrigger=PropertyChanged}"
                                             FontFamily="{StaticResource MonoFont}" />
                                </StackPanel>
                                <Button Grid.Column="4" Content="Generar clave" Style="{StaticResource GhostButton}"
                                        VerticalAlignment="Bottom" Command="{Binding GenerateWifiCommand}" />
                            </Grid>

                            <WrapPanel Margin="0,16,0,0">
                                <CheckBox Content="WiFi encendido" IsChecked="{Binding WifiEnabled}" Margin="0,0,20,0" />
                                <CheckBox Content="Mostrar el nombre de la red" IsChecked="{Binding WifiBroadcast}" Margin="0,0,20,0" />
                                <CheckBox Content="Prioridad de video y voz (WMM)" IsChecked="{Binding WifiWmm}" Margin="0,0,20,0" />
                                <CheckBox Content="Permitir WPS" IsChecked="{Binding WifiWps}" />
                            </WrapPanel>

                            <StackPanel Margin="0,16,0,0" Width="220" HorizontalAlignment="Left">
                                <TextBlock Text="Maximo de equipos" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding WifiMaxClients, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <Border Background="{StaticResource DangerSoft}" CornerRadius="8" Padding="12,10" Margin="0,16,0,0"
                                    Visibility="{Binding HasWifiError, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding WifiError}" Foreground="{StaticResource Danger}"
                                           FontSize="12.5" TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ══ Paso 5: revisar y aplicar ══ -->
                <StackPanel Visibility="{Binding IsStep5, Converter={StaticResource BoolToVisibility}}">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Resumen" Style="{StaticResource SectionTitle}" />
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Cliente" Style="{StaticResource Eyebrow}" Margin="0,0,0,10" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ReviewClient}" Style="{StaticResource Body}" Margin="0,0,0,10" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Equipo" Style="{StaticResource Eyebrow}" Margin="0,0,0,10" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ReviewOnu}" Style="{StaticResource Body}" Margin="0,0,0,10" />
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Internet" Style="{StaticResource Eyebrow}" Margin="0,0,0,10" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ReviewInternet}" Style="{StaticResource Body}" Margin="0,0,0,10" />
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="WiFi" Style="{StaticResource Eyebrow}" Margin="0,0,0,10" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ReviewWifi}" Style="{StaticResource Body}" Margin="0,0,0,10" />
                                <TextBlock Grid.Row="4" Grid.Column="0" Text="ISP Max" Style="{StaticResource Eyebrow}" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding ReviewCloud}" Style="{StaticResource Body}" />
                            </Grid>

                            <WrapPanel Margin="0,16,0,0">
                                <CheckBox Content="Guardar respaldo antes y despues" IsChecked="{Binding CreateBackups}" Margin="0,0,20,0" />
                                <CheckBox Content="Guardar en la memoria de la ONU" IsChecked="{Binding SaveConfiguration}" Margin="0,0,20,0" />
                                <CheckBox Content="Reemplazar una WAN en conflicto" IsChecked="{Binding ReplaceConflictingWan}" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="{Binding ProgressLabel}" Style="{StaticResource SectionTitle}" FontSize="14" />
                                <TextBlock Text="{Binding Progress, StringFormat={}{0}%}" HorizontalAlignment="Right"
                                           Style="{StaticResource Body}" />
                            </Grid>
                            <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="100" Margin="0,10,0,0" />

                            <ItemsControl ItemsSource="{Binding Timeline}" Margin="0,14,0,0" MaxHeight="240">
                                <ItemsControl.Template>
                                    <ControlTemplate TargetType="ItemsControl">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <ItemsPresenter />
                                        </ScrollViewer>
                                    </ControlTemplate>
                                </ItemsControl.Template>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="12" />
                                                <ColumnDefinition Width="64" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Grid.Column="0" Width="8" Height="8" VerticalAlignment="Center"
                                                     Fill="{Binding Status, Converter={StaticResource Tone}}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Time}" FontSize="11.5"
                                                       Foreground="{StaticResource InkSoft}" VerticalAlignment="Center"
                                                       Margin="6,0,0,0" />
                                            <TextBlock Grid.Column="2" Text="{Binding Message}" FontSize="12.5"
                                                       Foreground="{StaticResource Ink}" TextWrapping="Wrap" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border Background="{StaticResource SuccessSoft}" CornerRadius="8" Padding="14,12" Margin="0,10,0,0"
                                    Visibility="{Binding Finished, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock Text="ONU configurada y verificada" FontWeight="SemiBold" FontSize="13.5"
                                               Foreground="{StaticResource Success}" />
                                    <Button Content="Configurar otro cliente" Style="{StaticResource LinkButton}"
                                            HorizontalAlignment="Left" Margin="0,6,0,0"
                                            Command="{Binding RestartCommand}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- ── Pie con la accion principal ── -->
        <Border Grid.Row="2" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                BorderThickness="0,1,0,0" Padding="32,16">
            <Grid>
                <Button Content="Atras" Style="{StaticResource GhostButton}" HorizontalAlignment="Left"
                        Command="{Binding BackCommand}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding BusyMessage}" Style="{StaticResource Body}" VerticalAlignment="Center"
                               Margin="0,0,16,0" MaxWidth="420"
                               Visibility="{Binding BusyMessage, Converter={StaticResource TextToVisibility}}" />
                    <Button Content="{Binding NextLabel}" Style="{StaticResource PrimaryButton}"
                            Command="{Binding NextCommand}"
                            Visibility="{Binding IsStep5, Converter={StaticResource InverseBoolToVisibility}}" />
                    <Button Content="Aprovisionar la ONU" Style="{StaticResource SuccessButton}"
                            Command="{Binding ProvisionCommand}"
                            Visibility="{Binding IsStep5, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
