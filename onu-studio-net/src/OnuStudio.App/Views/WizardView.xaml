<UserControl x:Class="OnuStudio.App.Views.WizardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:OnuStudio.App.Controls"
             xmlns:wizard="clr-namespace:OnuStudio.App.Views.Wizard"
             FontFamily="{StaticResource UiFont}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ── Pasos ── -->
        <Border Grid.Row="0" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                BorderThickness="0,0,0,1" Padding="32,14">
            <ItemsControl ItemsSource="{Binding Steps}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <!-- Linea que une con el paso anterior; se pone verde al avanzar -->
                            <Border x:Name="Link" Width="44" Height="2" CornerRadius="1" Margin="10,0"
                                    VerticalAlignment="Center" Background="{StaticResource Line}" />
                            <Grid Width="30" Height="30" RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <ScaleTransform x:Name="Pop" ScaleX="1" ScaleY="1" />
                                </Grid.RenderTransform>
                                <Ellipse x:Name="Dot" Fill="{StaticResource LineSoft}" Stroke="{StaticResource Line}" StrokeThickness="1.5" />
                                <TextBlock x:Name="Num" Text="{Binding Number}" FontSize="12.5" FontWeight="Bold"
                                           Foreground="{StaticResource InkSoft}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Path x:Name="Tick" Data="M 9,15.5 L 13,19.5 L 21.5,10.5" Stroke="White" StrokeThickness="2.4"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed" />
                            </Grid>
                            <TextBlock x:Name="Caption" Text="{Binding Caption}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource InkSoft}" VerticalAlignment="Center" Margin="9,0,0,0" />
                        </StackPanel>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsFirst}" Value="True">
                                <Setter TargetName="Link" Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                <Setter TargetName="Dot" Property="Fill" Value="{StaticResource Accent}" />
                                <Setter TargetName="Dot" Property="Stroke" Value="{StaticResource Accent}" />
                                <Setter TargetName="Num" Property="Foreground" Value="White" />
                                <Setter TargetName="Caption" Property="Foreground" Value="{StaticResource Ink}" />
                                <Setter TargetName="Link" Property="Background" Value="{StaticResource Accent}" />
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Pop" Storyboard.TargetProperty="ScaleX"
                                                             From="0.7" To="1" Duration="0:0:0.35">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase EasingMode="EaseOut" Amplitude="0.5" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="Pop" Storyboard.TargetProperty="ScaleY"
                                                             From="0.7" To="1" Duration="0:0:0.35">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase EasingMode="EaseOut" Amplitude="0.5" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsDone}" Value="True">
                                <Setter TargetName="Dot" Property="Fill" Value="{StaticResource Success}" />
                                <Setter TargetName="Dot" Property="Stroke" Value="{StaticResource Success}" />
                                <Setter TargetName="Num" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Caption" Property="Foreground" Value="{StaticResource Success}" />
                                <Setter TargetName="Link" Property="Background" Value="{StaticResource Success}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <!-- ── Contenido del paso ── -->
        <ScrollViewer x:Name="Scroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="32,26">
            <!-- Una sola tarjeta en el centro; arriba, donde vas y lo que ya elegiste -->
            <StackPanel MaxWidth="860" HorizontalAlignment="Stretch">

                <Grid Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                Visibility="{Binding HasSubSteps, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl ItemsSource="{Binding SubStepDots}" VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="Dot" Width="8" Height="8" CornerRadius="4" Margin="0,0,6,0"
                                            Background="{StaticResource Line}" />
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding}" Value="ok">
                                            <Setter TargetName="Dot" Property="Background" Value="{StaticResource Success}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding}" Value="info">
                                            <Setter TargetName="Dot" Property="Background" Value="{StaticResource Accent}" />
                                            <Setter TargetName="Dot" Property="Width" Value="26" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding SubStepLabel}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource InkSoft}" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <Border Background="{StaticResource AccentSoft}" CornerRadius="10" Padding="16,10" Margin="0,0,0,16"
                        Visibility="{Binding HasStepAnswers, Converter={StaticResource BoolToVisibility}}">
                    <DockPanel>
                        <TextBlock Text="ELEGIDO" Style="{StaticResource Eyebrow}" Foreground="{StaticResource Accent}"
                                   VerticalAlignment="Center" Margin="0,0,12,0" />
                        <TextBlock Text="{Binding StepAnswers}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentDark}" TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                    </DockPanel>
                </Border>

                <wizard:DetectStepView Visibility="{Binding IsStep1, Converter={StaticResource BoolToVisibility}}" />
                <wizard:ClientStepView Visibility="{Binding IsStep2, Converter={StaticResource BoolToVisibility}}" />
                <wizard:InternetStepView Visibility="{Binding IsStep3, Converter={StaticResource BoolToVisibility}}" />
                <wizard:WifiStepView Visibility="{Binding IsStep4, Converter={StaticResource BoolToVisibility}}" />
                <wizard:ReviewStepView Visibility="{Binding IsStep5, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </ScrollViewer>

        <!-- ── Pie con la accion principal ── -->
        <Border Grid.Row="2" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                BorderThickness="0,1,0,0" Padding="32,16">
            <Grid>
                <Button Content="Atras" Style="{StaticResource GhostButton}" HorizontalAlignment="Left"
                        Command="{Binding BackCommand}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <controls:Spinner Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,10,0"
                                      Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{Binding BusyMessage}" Style="{StaticResource Body}" VerticalAlignment="Center"
                               Margin="0,0,16,0" MaxWidth="420"
                               Visibility="{Binding BusyMessage, Converter={StaticResource TextToVisibility}}" />
                    <Button Content="{Binding NextLabel}" Style="{StaticResource PrimaryButton}"
                            Command="{Binding NextCommand}"
                            Visibility="{Binding IsStep5, Converter={StaticResource InverseBoolToVisibility}}" />
                    <Button Content="Aprovisionar la ONU" Style="{StaticResource SuccessButton}"
                            Command="{Binding ProvisionCommand}"
                            Visibility="{Binding ShowProvisionButton, Converter={StaticResource BoolToVisibility}}" />
                    <Button Content="Configurar otro cliente" Style="{StaticResource PrimaryButton}" MinHeight="48"
                            FontSize="15" Command="{Binding RestartCommand}"
                            Visibility="{Binding Finished, Converter={StaticResource BoolToVisibility}}"
                            controls:Motion.Entrance="True" controls:Motion.OffsetY="8" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
