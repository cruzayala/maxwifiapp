<UserControl x:Class="OnuStudio.App.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="32,16,32,0">
            <Button Content="Actualizar" Style="{StaticResource GhostButton}" HorizontalAlignment="Left"
                    Command="{Binding RefreshCommand}" />
        </Border>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="32,16,32,28" VerticalAlignment="Top"
                MaxWidth="620" HorizontalAlignment="Left"
                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock Text="Sin trabajos todavia" Style="{StaticResource SectionTitle}" />
                <TextBlock Style="{StaticResource Body}" Margin="0,8,0,0"
                           Text="Cuando configures o compruebes una ONU desde esta computadora, el resultado quedara guardado aqui." />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="32,16,32,24"
                      Visibility="{Binding IsEmpty, Converter={StaticResource InverseBoolToVisibility}}">
            <ItemsControl ItemsSource="{Binding Entries}" MaxWidth="1040" HorizontalAlignment="Left">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" CornerRadius="12" Padding="10,4" VerticalAlignment="Top"
                                        Background="{Binding StatusTone, Converter={StaticResource ToneSoft}}">
                                    <TextBlock Text="{Binding StatusLabel}" FontSize="11.5" FontWeight="Bold"
                                               Foreground="{Binding StatusTone, Converter={StaticResource Tone}}" />
                                </Border>

                                <StackPanel Grid.Column="1" Margin="14,0,14,0">
                                    <TextBlock FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource Ink}">
                                        <Run Text="{Binding Kind, Mode=OneWay}" />
                                        <Run Text=" · " />
                                        <Run Text="{Binding Host, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock FontSize="12" Foreground="{StaticResource InkSoft}" Margin="0,4,0,0">
                                        <Run Text="IP " />
                                        <Run Text="{Binding WanIp, Mode=OneWay}" />
                                        <Run Text="  ·  WiFi " />
                                        <Run Text="{Binding Ssid, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding Error}" FontSize="12" Foreground="{StaticResource Danger}"
                                               TextWrapping="Wrap" Margin="0,6,0,0"
                                               Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding When}" FontSize="12" Foreground="{StaticResource InkMuted}"
                                               HorizontalAlignment="Right" />
                                    <TextBlock Text="{Binding Duration}" FontSize="11.5" Foreground="{StaticResource InkSoft}"
                                               HorizontalAlignment="Right" Margin="0,4,0,0" />
                                    <Button Content="Retomar este trabajo" Style="{StaticResource LinkButton}"
                                            HorizontalAlignment="Right" Margin="0,6,0,0"
                                            Visibility="{Binding CanRetry, Converter={StaticResource BoolToVisibility}}"
                                            Command="{Binding DataContext.RetryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
