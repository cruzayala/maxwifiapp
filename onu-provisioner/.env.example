ONU_DEFAULT_USERNAME=telecomadmin
ONU_DEFAULT_PASSWORD=
ONU_ZTE_DEFAULT_USERNAME=admin
ONU_ZTE_DEFAULT_PASSWORD=
ONU_HEADLESS=true
ONU_PORT=8765
# TR-069 se configura en la misma WAN como servicio TR069_INTERNET.
ONU_TR069_ENABLED=true
ONU_TR069_ACS_URL=http://10.254.250.2:7547/
ONU_TR069_USERNAME=
ONU_TR069_PASSWORD=
ONU_TR069_CONNECTION_REQUEST_USERNAME=
ONU_TR069_CONNECTION_REQUEST_PASSWORD=
ONU_MAINTENANCE_TOKEN=
ONU_TR069_PERIODIC_INFORM_INTERVAL=900
# URL del backend actual. Cambiala al mover ISP Max a otro proveedor o entorno.
ISP_MAX_CLOUD_URL=http://127.0.0.1:7401
# Incluye el origen de cada panel remoto autorizado a hablar con el agente local.
ONU_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200,http://localhost:7400,http://127.0.0.1:7400,https://tu-entorno.example.com
